generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Users {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt
  role        String   @default("user")
  first_name  String?
  last_name   String?
  email       String   @unique
  password    String?
  nationality String   @default("Filipino")
  google_id   String?  @unique
  avatar_url  String?

  products Product[]
  payment_methods PaymentMethod[]
  
  @@map("users")
}

model Registrees {
  first_name        String
  last_name         String
  password          String
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String
  verificationCode  String
  codeExpiry        DateTime
  nextAllowedResend DateTime
  resendCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("registrees")
}

model Product {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @db.VarChar(100)
  price      Float
  maxPersons Int
  about      String?  @db.VarChar(1000)
  attributes Json?    // array of objects: { name, iconId, quantity }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String   @db.Uuid   // ← foreign key
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade) // relation field

  photos     Photo[]

  @@map("products")
}

model Photo {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image_url  String
  alt        String
  order_index Int
  productId   String   @db.Uuid
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model PaymentMethod {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_method  String
  account_name    String
  account_number  String
  image_url       String

  userId     String   @db.Uuid
  user       Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

